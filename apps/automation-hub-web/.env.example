NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials. NEVER add NEXT_PUBLIC_ to these keys.
# Set these only in Vercel Environment Variables or .env.local (ignored by git).
# Supabase: Project Settings > API Keys > legacy service_role (server only).
SUPABASE_SERVICE_ROLE_KEY=
# Telegram @automated_hub_bot token from @BotFather; never paste it in chat.
TELEGRAM_BOT_TOKEN=
# 32+ random characters used as Telegram setWebhook secret_token.
TELEGRAM_WEBHOOK_SECRET=

# Separately configure the SAME Telegram bot token and secret in
# Supabase Edge Functions > Secrets for the public webhook endpoint.
